# Generated by Feat for the application runtime of task 11111111-1111-4111-8111-111111111111 of project app.
#
# Do not edit: it is rewritten every time the task's services are created or
# started, and it is merged last over the generated include of the repositories
# this application is composed of. Compose merges a service's volumes by
# target, so each mount below replaces whatever those files mounted at that
# path rather than adding a second mount beside it.
#
# container_name is reset because it is global to the Docker daemon: a base file
# carrying one could be started for one task and no more. A published port is
# global to the machine in the same way, so every one of them is replaced: the
# services this project declares reachable are published on the ports Feat
# allocated for this task, and the rest publish nothing.
#
# A service that bakes its code into its image has no mount to replace, so its
# build context is pointed at the task's worktree instead. Only the context is
# written: a relative dockerfile beside it follows the new context.
services:
  "api":
    container_name: !reset null
    ports: !override
      # allocated for this task; reached at localhost:21000
      - target: 8080
        published: "21000"
        protocol: "tcp"
        host_ip: "127.0.0.1"
    build:
      # the api task worktree, which this service's image is built from
      context: "/worktrees/api"
    volumes:
      # the api task worktree, read-write
      - type: "bind"
        source: "/worktrees/api"
        target: "/srv/api"
        read_only: false
      # the store task worktree, read-only
      - type: "bind"
        source: "/worktrees/store"
        target: "/srv/store"
        read_only: true
    environment:
      "FEAT_HOST_PORT_API": "21000"
      "FEAT_HOST_URL_API": "http://localhost:21000"
      "FEAT_RUNTIME_PROJECT": "feat-app-11111111"
      "FEAT_TASK_KEY": "11111111"
    labels:
      "dev.feat.owner": "feat"
      "dev.feat.project": "app"
      "dev.feat.task": "11111111-1111-4111-8111-111111111111"
      "dev.feat.kind": "runtime"
      "dev.feat.schema": "1"
