# Generated by Feat for task 11111111-1111-4111-8111-111111111111 of project app.
#
# Do not edit: it is rewritten every time the task's environment starts, and
# it is merged last over the project's own Compose files. Compose merges a
# service's volumes by target, so each mount below replaces whatever the base
# files mounted at that path rather than adding a second mount beside it.
#
# container_name and ports are reset because both are global: a container name
# to the Docker daemon and a published port to the host. A base file carrying
# either could run for one task and no more.
services:
  "dev":
    container_name: !reset null
    ports: !reset []
    working_dir: "/srv/api"
    volumes:
      # the api task worktree
      - type: "bind"
        source: "/worktrees/api"
        target: "/srv/api"
        read_only: false
      # the store task worktree, read-only
      - type: "bind"
        source: "/worktrees/store"
        target: "/srv/store"
        read_only: true
      # the control workspace
      - type: "bind"
        source: "<state>/control"
        target: "/feat"
        read_only: false
      - type: "volume"
        source: "feat-claude"
        target: "/feat-claude"
        read_only: false
    environment:
      "CLAUDE_CONFIG_DIR": "/feat-claude"
    labels:
      "dev.feat.owner": "feat"
      "dev.feat.project": "app"
      "dev.feat.task": "11111111-1111-4111-8111-111111111111"
      "dev.feat.schema": "1"
volumes:
  "feat-claude":
    name: "feat-claude"
